{
  "name": "dsh-session-id-copy",
  "version": "0.2.0",
  "description": "DeepSeek Harness plugin: show a 6-character session id badge next to the conversation title and copy the full session id on click",
  "license": "MIT",
  "author": "prgrmrwy",
  "homepage": "https://github.com/prgrmrwy/dsh-session-id-copy#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prgrmrwy/dsh-session-id-copy.git"
  },
  "bugs": {
    "url": "https://github.com/prgrmrwy/dsh-session-id-copy/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "plugin",
    "session",
    "session-id",
    "clipboard",
    "title",
    "ui"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs",
    "screenshots.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "clean": "node -e \"require('node:fs/promises').rm('lib',{recursive:true,force:true}).catch(error=>{console.error(error);process.exitCode=1})\"",
    "build:host": "tsc -p tsconfig.json",
    "build:client": "tsdown",
    "build": "npm run clean && npm run build:host && npm run build:client",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "npm run build",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=22.19"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-api-session-controller": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-locale": "^0.2.0-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-api-session-controller": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-locale": "^0.2.0-rc.2",
    "@types/node": "^24.19.2",
    "tsdown": "^0.23.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "ohmydsh": {
    "docTier": "B"
  }
}
