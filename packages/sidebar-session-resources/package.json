{
  "name": "dsh-sidebar-session-resources",
  "version": "0.2.0",
  "description": "Session links panel: collect and categorize MR / deploy / work-item / artifact URLs from the current conversation into a dsh-better-sidebar tab",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-files",
        "@deepseek-ai/dsh-client-ui-file-actions"
      ]
    }
  },
  "scripts": {
    "clean": "node -e \"require('node:fs/promises').rm('lib',{recursive:true,force:true}).catch(error=>{console.error(error);process.exitCode=1})\"",
    "build:host": "tsc -p tsconfig.json",
    "build:client": "tsdown",
    "build": "npm run clean && npm run build:host && npm run build:client",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=22.19",
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-api-session-controller": ">=0.2.2-rc.1 <0.3.0-0 || ^0.2.2-rc.1",
    "@deepseek-ai/dsh-api-workspace-files": ">=0.2.2-rc.1 <0.3.0-0 || ^0.2.2-rc.1",
    "@deepseek-ai/dsh-client-connection": ">=0.2.2-rc.1 <0.3.0-0 || ^0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-file-actions": ">=0.2.2-rc.1 <0.3.0-0 || ^0.2.2-rc.1",
    "dsh-better-sidebar": ">=0.16.0",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "dsh-better-sidebar": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-api-gateway": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-api-session-controller": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-api-workspace-files": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-client-connection": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-chat": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-context-menu": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-deliverables": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-file-actions": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-session": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-session": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-session-persistence": "^0.2.2-rc.1",
    "@types/node": "^24.19.2",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "react-dom": "^18.3.1",
    "tsdown": "^0.23.5",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "ohmydsh": {
    "docTier": "B"
  }
}
