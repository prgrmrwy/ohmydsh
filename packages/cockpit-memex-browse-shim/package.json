{
  "name": "dsh-cockpit-memex-browse-shim",
  "version": "0.2.0",
  "description": "Deployment-local adapter from dsh-cockpit-bridge port publishing to the dsh-memex browse-address registry",
  "license": "MIT",
  "author": "prgrmrwy",
  "homepage": "https://github.com/prgrmrwy/dsh-cockpit-memex-browse-shim#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prgrmrwy/dsh-cockpit-memex-browse-shim.git"
  },
  "bugs": {
    "url": "https://github.com/prgrmrwy/dsh-cockpit-memex-browse-shim/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "dsh-cockpit",
    "shim",
    "memex",
    "port-forward",
    "browse"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "scripts": {
    "clean": "node -e \"require('node:fs/promises').rm('lib',{recursive:true,force:true}).catch(error=>{console.error(error);process.exitCode=1})\"",
    "build:host": "tsc -p tsconfig.json",
    "build:client": "tsdown",
    "build": "npm run clean && npm run build:host && npm run build:client",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "vitest run",
    "prepare": "npm run build",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=22.19"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@types/node": "^24.19.2",
    "tsdown": "^0.23.5",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "ohmydsh": {
    "docTier": "C"
  }
}
