# Generated by build.mjs from the pinned upstream source plus the tracked
# patch. Never committed: `settlement-notice.patch` and `package.template.json`
# are the reviewable truth, and everything here is reproducible from them.
lib/
.upstream/
package.json
.launcher
.launcher-builds/
.launcher.next-*
.launcher.restore-*
.launcher.previous-*
# No longer produced: storage is served by Pet's own registered backend
# (src/host/storage/), and the isolated-claim seam was removed. Kept so a
# directory left over from an earlier build can never be committed by accident.
.storage-upstream/
storage-artifacts
agent-artifacts/
.storage-artifact-builds/
.storage-artifacts.staging-*
.storage-artifacts.next-*
.storage-artifacts.restore-*
.storage-artifacts.previous-*
.compat-build.lock/
.compat-build.lock.reclaim-*
