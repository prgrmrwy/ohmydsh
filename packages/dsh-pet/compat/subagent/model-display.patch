diff --git a/packages/client/ui-model-selection/src/client/display-groups.ts b/packages/client/ui-model-selection/src/client/display-groups.ts
new file mode 100644
index 0000000..bbb40df
--- /dev/null
+++ b/packages/client/ui-model-selection/src/client/display-groups.ts
@@ -0,0 +1,38 @@
+/** Private presentation buckets shared by the two model-selection entries. */
+import type { ModelCatalogModel, ModelProviderGroup } from '@deepseek-ai/dsh-api-session-controller/types'
+import { orderModelProviders } from './provider-order.ts'
+
+interface DisplayGroup {
+  /** Collision-free presentation key; never submitted as a provider. */
+  key: string
+  /** The real registered provider route. */
+  id: string
+  name: string
+  models: ModelCatalogModel[]
+}
+
+/** Derive ordered buckets without mutating provider catalogs or model names. */
+export function displayModelGroups(groups: readonly ModelProviderGroup[], accountLabel: string): DisplayGroup[] {
+  return orderModelProviders(groups).flatMap(provider => {
+    const buckets = new Map<string, DisplayGroup>()
+    for (const model of provider.models) {
+      const key = JSON.stringify([provider.id, model.displayGroup?.id ?? null])
+      let bucket = buckets.get(key)
+      if (bucket === undefined) {
+        bucket = {
+          key, id: provider.id,
+          name: model.displayGroup?.label ?? (provider.id === 'deepseek-account' ? accountLabel : provider.name),
+          models: [],
+        }
+        buckets.set(key, bucket)
+      }
+      bucket.models.push(model)
+    }
+    return [...buckets.values()]
+  })
+}
+
+/** Search aliases remain separate from displayed names and submitted ids. */
+export function modelSearchText(model: ModelCatalogModel, groupLabel: string): string {
+  return `${groupLabel} ${model.name} ${model.id}`
+}
