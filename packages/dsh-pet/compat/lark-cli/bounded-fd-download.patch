+func fdDownloadRuntime(t *testing.T, values map[string]string) *common.RuntimeContext {
+	t.Helper()
+	cmd := &cobra.Command{Use: "test"}
+	for _, flag := range []string{"message-id", "file-key", "type", "output", "output-fd", "max-bytes"} {
+		cmd.Flags().String(flag, "", "")
+	}
+	for name, value := range values {
+		if err := cmd.Flags().Set(name, value); err != nil {
+			t.Fatalf("set --%s: %v", name, err)
+		}
+	}
+	return &common.RuntimeContext{Cmd: cmd}
+}
+
+func TestParseIMResourceFDModeRequiresPairedExclusiveFlags(t *testing.T) {
+	tests := []struct {
+		name   string
+		values map[string]string
+		param  string
+	}{
+		{name: "fd alone", values: map[string]string{"output-fd": "3"}, param: "--max-bytes"},
+		{name: "max alone", values: map[string]string{"max-bytes": "10"}, param: "--output-fd"},
+		{name: "output conflict", values: map[string]string{"output-fd": "3", "max-bytes": "10", "output": "out.bin"}, param: "--output"},
+		{name: "stdio descriptor rejected", values: map[string]string{"output-fd": "1", "max-bytes": "10"}, param: "--output-fd"},
+		{name: "zero limit rejected", values: map[string]string{"output-fd": "3", "max-bytes": "0"}, param: "--max-bytes"},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			_, _, _, err := parseIMResourceFDMode(fdDownloadRuntime(t, test.values))
+			if err == nil {
+				t.Fatal("parseIMResourceFDMode() error = nil")
+			}
+			problem, ok := errs.ProblemOf(err)
+			if !ok || problem.Category != errs.CategoryValidation {
+				t.Fatalf("parseIMResourceFDMode() error = %#v, want typed validation", err)
+			}
+			if !strings.Contains(err.Error(), test.param) {
+				t.Fatalf("parseIMResourceFDMode() error = %v, want %s", err, test.param)
+			}
+		})
+	}
+}
+
+func TestDownloadIMResourceToFDCopiesOnlyToInheritedDescriptor(t *testing.T) {
+	payload := []byte("bounded-binary-payload")
+	runtime := newBotShortcutRuntime(t, shortcutRoundTripFunc(func(req *http.Request) (*http.Response, error) {
+		if got := req.URL.Path; got != "/open-apis/im/v1/messages/om_123/resources/img_123" {
+			t.Fatalf("request path = %q", got)
+		}
+		return shortcutRawResponse(http.StatusOK, payload, http.Header{"Content-Type": []string{"image/png"}}), nil
+	}))
+	reader, writer, err := os.Pipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer reader.Close()
+	defer writer.Close()
+
+	written, contentType, err := downloadIMResourceToFD(context.Background(), runtime, "om_123", "img_123", "image", int(writer.Fd()), int64(len(payload)))
+	if err != nil {
+		t.Fatalf("downloadIMResourceToFD() error = %v", err)
+	}
+	if written != int64(len(payload)) || contentType != "image/png" {
+		t.Fatalf("downloadIMResourceToFD() = (%d, %q), want (%d, image/png)", written, contentType, len(payload))
+	}
+	got := make([]byte, len(payload))
+	if _, err := io.ReadFull(reader, got); err != nil {
+		t.Fatal(err)
+	}
+	if string(got) != string(payload) {
+		t.Fatalf("fd bytes = %q, want %q", got, payload)
+	}
+}
+
+func TestDownloadIMResourceToFDRejectsKnownOversizeBeforeWrite(t *testing.T) {
+	payload := []byte("oversize")
+	runtime := newBotShortcutRuntime(t, shortcutRoundTripFunc(func(*http.Request) (*http.Response, error) {
+		return shortcutRawResponse(http.StatusOK, payload, nil), nil
+	}))
+	reader, writer, err := os.Pipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer reader.Close()
+	defer writer.Close()
+
+	written, _, err := downloadIMResourceToFD(context.Background(), runtime, "om_123", "img_123", "image", int(writer.Fd()), int64(len(payload)-1))
+	if err == nil || written != 0 {
+		t.Fatalf("downloadIMResourceToFD() = (%d, %v), want typed pre-copy rejection", written, err)
+	}
+	problem, ok := errs.ProblemOf(err)
+	if !ok || problem.Category != errs.CategoryValidation || problem.Subtype != errs.SubtypeFailedPrecondition {
+		t.Fatalf("oversize error = %#v, want validation/failed_precondition", err)
+	}
+}
+
+func TestDownloadIMResourceToFDRejectsUnknownOversizeAfterMaxPlusOne(t *testing.T) {
+	payload := []byte("oversize")
+	runtime := newBotShortcutRuntime(t, shortcutRoundTripFunc(func(*http.Request) (*http.Response, error) {
+		resp := shortcutRawResponse(http.StatusOK, payload, nil)
+		resp.ContentLength = -1
+		return resp, nil
+	}))
+	reader, writer, err := os.Pipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer reader.Close()
+	defer writer.Close()
+
+	maxBytes := int64(4)
+	written, _, err := downloadIMResourceToFD(context.Background(), runtime, "om_123", "img_123", "image", int(writer.Fd()), maxBytes)
+	if err == nil || written != maxBytes+1 {
+		t.Fatalf("downloadIMResourceToFD() = (%d, %v), want max+1 typed rejection", written, err)
+	}
+	problem, ok := errs.ProblemOf(err)
+	if !ok || problem.Category != errs.CategoryValidation || problem.Subtype != errs.SubtypeFailedPrecondition {
+		t.Fatalf("oversize error = %#v, want validation/failed_precondition", err)
+	}
+}
