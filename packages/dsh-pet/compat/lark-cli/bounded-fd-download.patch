+func parseIMResourceFDMode(runtime *common.RuntimeContext) (bool, int, int64, error) {
+	fdSet := runtime.Changed("output-fd")
+	maxSet := runtime.Changed("max-bytes")
+	if fdSet != maxSet {
+		return false, 0, 0, errs.NewValidationError(errs.SubtypeInvalidArgument, "--output-fd and --max-bytes must be provided together").
+			WithParams(
+				errs.InvalidParam{Name: "--output-fd", Reason: "required together with --max-bytes"},
+				errs.InvalidParam{Name: "--max-bytes", Reason: "required together with --output-fd"},
+			)
+	}
+	if !fdSet {
+		return false, 0, 0, nil
+	}
+	if runtime.Changed("output") {
+		return false, 0, 0, errs.NewValidationError(errs.SubtypeInvalidArgument, "--output conflicts with --output-fd").
+			WithParams(
+				errs.InvalidParam{Name: "--output", Reason: "cannot be combined with --output-fd"},
+				errs.InvalidParam{Name: "--output-fd", Reason: "cannot be combined with --output"},
+			)
+	}
+	if goruntime.GOOS == "windows" {
+		return false, 0, 0, errs.NewValidationError(errs.SubtypeFailedPrecondition, "--output-fd is available only on POSIX hosts")
+	}
+	fd, err := strconv.Atoi(strings.TrimSpace(runtime.Str("output-fd")))
+	if err != nil || fd < 3 {
+		return false, 0, 0, errs.NewValidationError(errs.SubtypeInvalidArgument, "--output-fd must be an inherited file descriptor >= 3").WithParam("--output-fd").WithCause(err)
+	}
+	maxBytes, err := strconv.ParseInt(strings.TrimSpace(runtime.Str("max-bytes")), 10, 64)
+	if err != nil || maxBytes <= 0 || maxBytes == int64(^uint64(0)>>1) {
+		return false, 0, 0, errs.NewValidationError(errs.SubtypeInvalidArgument, "--max-bytes must be a positive integer below 9223372036854775807").WithParam("--max-bytes").WithCause(err)
+	}
+	return true, fd, maxBytes, nil
+}
+
+func downloadIMResourceToFD(ctx context.Context, runtime *common.RuntimeContext, messageID, fileKey, fileType string, outputFD int, maxBytes int64) (int64, string, error) {
+	stream, err := openIMResourceDownload(ctx, runtime, messageID, fileKey, fileType)
+	if err != nil {
+		return 0, "", err
+	}
+	defer stream.Body.Close()
+
+	if stream.ContentLength >= 0 && stream.ContentLength > maxBytes {
+		return 0, "", errs.NewValidationError(errs.SubtypeFailedPrecondition, "resource content length %d exceeds --max-bytes %d", stream.ContentLength, maxBytes)
+	}
+	// Host-only boundary: the caller deliberately inherited this already-open
+	// descriptor. FileIO is path-oriented and cannot represent an inherited fd.
+	//nolint:forbidigo // os.NewFile is required by the bounded no-path Host seam.
+	output := os.NewFile(uintptr(outputFD), "lark-cli-host-output")
+	if output == nil {
+		return 0, "", errs.NewInternalError(errs.SubtypeFileIO, "inherited output fd %d is unavailable", outputFD)
+	}
+	limited := &io.LimitedReader{R: stream.Body, N: maxBytes + 1}
+	written, copyErr := io.Copy(output, limited)
+	if copyErr != nil {
+		return written, "", errs.NewInternalError(errs.SubtypeFileIO, "write inherited output fd %d: %v", outputFD, copyErr).WithCause(copyErr)
+	}
+	if written > maxBytes {
+		return written, "", errs.NewValidationError(errs.SubtypeFailedPrecondition, "resource exceeds --max-bytes %d", maxBytes)
+	}
+	if stream.ContentLength >= 0 && written != stream.ContentLength {
+		return written, "", errs.NewNetworkError(errs.SubtypeNetworkTransport, "file size mismatch: expected %d, got %d", stream.ContentLength, written)
+	}
+	return written, stream.Header.Get("Content-Type"), nil
+}
