{
  "name": "dsh-host-browsing",
  "version": "0.1.0",
  "description": "When DSH drives a remote machine, open that machine's own localhost services right in the sidebar, with no per-port SSH tunnels.",
  "license": "MIT",
  "author": "prgrmrwy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prgrmrwy/dsh-host-browsing.git"
  },
  "homepage": "https://github.com/prgrmrwy/dsh-host-browsing#readme",
  "bugs": {
    "url": "https://github.com/prgrmrwy/dsh-host-browsing/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "localhost",
    "remote",
    "port-forward",
    "proxy"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs/*.png",
    "docs/*.svg",
    "docs/*.json",
    "docs/SCREENSHOTS.md",
    "screenshots.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "clean": "node -e \"require('node:fs/promises').rm('lib',{recursive:true,force:true}).catch(error=>{console.error(error);process.exitCode=1})\"",
    "build:types": "tsc -p tsconfig.json",
    "build:bundles": "tsdown",
    "build": "npm run clean && npm run build:bundles && npm run build:types",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.sw.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "npm run build && vitest run --config vitest.browser.config.ts",
    "prepare": "npm run build",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=22.19",
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-client-connection": ">=0.2.2-rc.1 <0.3.0-0 || ^0.2.2-rc.1",
    "@deepseek-ai/dsh-client-locale": ">=0.2.2-rc.1 <0.3.0-0 || ^0.2.2-rc.1",
    "@deepseek-ai/dsh-host-webserver": ">=0.2.2-rc.1 <0.3.0-0 || ^0.2.2-rc.1",
    "dsh-better-sidebar": ">=0.16.0",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "dsh-better-sidebar": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-client-connection": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-client-locale": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-host-frontend-static": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-host-webserver": "^0.2.2-rc.1",
    "@types/node": "^24.19.2",
    "@types/react": "~18.3.1",
    "@types/ws": "^8.18.1",
    "jsdom": "^26.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.3.1",
    "tsdown": "^0.23.7",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1",
    "ws": "^8.23.0"
  },
  "ohmydsh": {
    "docTier": "C"
  }
}
