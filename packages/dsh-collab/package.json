{
  "name": "dsh-collab",
  "version": "0.1.0",
  "description": "Allowlisted independent DSH sessions collaborating through a Host-owned ledger",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "bin": { "dsh-collab-unlock": "./lib/unlock.mjs" },
  "types": "./lib/index.d.ts",
  "exports": { ".": { "types": "./lib/index.d.ts", "default": "./lib/index.js" } },
  "files": ["lib", "cordis.patch.yml", "README.md", "README.zh.md", "LICENSE"],
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run && node --test test/build-artifact.test.mjs test/sync-artifact.test.mjs",
    "test:components": "npm run build && node test/run-components.mjs && node test/run-components.mjs --controller",
    "test:host": "npm run build && node test/released-host-seams.mjs --consumer && node test/official-composition.mjs",
    "test:host:kernel": "node test/released-host-seams.mjs",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/schemastery": "^3.18.4",
    "@deepseek-ai/dsh-agent": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-api-session-controller": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-session-query": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-workspace": "^0.2.0-rc.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "collab-kernel": "*",
    "tsdown": "^0.23.0",
    "vitest": "^5.0.1",
    "typescript": "^5.9.3"
  },
  "ohmydsh": { "docTier": "C" }
}
