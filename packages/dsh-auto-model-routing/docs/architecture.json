  "cards": [
    {
      "dot": "emerald",
      "title": "Main chat (AUTO)",
      "items": [
        "Judged once per user turn at step 1; continued turns reuse the last tier",
        "Only reasoning effort changes; provider and model stay as selected",
        "mainEfforts[provider][tier] covers all family models; defaults remain model-specific"
      ]
    },
    {
      "dot": "rose",
      "title": "Fail closed",
      "items": [
        "Any Jev failure sets MANUAL and records the category; no local fallback",
        "MANUAL passes requests through unchanged and sends nothing out"
      ]
    },
    {
      "dot": "cyan",
      "title": "Sub-agents",
      "items": [
        "route_subagent walks up to the root chat and judges only when it is AUTO",
        "Exact child model + effort or defaults, checked against catalog and allowlist"
      ]
    },
    {
      "dot": "violet",
      "title": "Local files",
      "items": [
        "state/auto-model-routing/sessions/*.json (mode, tier, disabled)",
        "state/auto-model-routing/judgements.jsonl (no message text)",
        "plugins/dsh-auto-model-routing/config.json (non-secret overrides)",
        "Official credential store owns the key; settings never return its value"
      ]
    },
    {
      "dot": "cyan",
      "title": "Working-tree documentation",
      "items": [
        "Source notes describe the current implementation, not an immutable commit",
        "Settings errors block invalid routes without Jev disable or silent fallback"
      ]
    },
    {
      "dot": "violet",
      "title": "Source notes (local working tree)",
      "items": [
        "packages/auto-model-routing/src/settings.ts + settings-host.ts: storage, catalog, credentials",
