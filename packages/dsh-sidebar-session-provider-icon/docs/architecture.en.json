  "cards": [
    {
      "dot": "cyan",
      "title": "Selection precedence",
      "items": [
        "A live composer selection wins while the open session can still be verified",
        "Otherwise the official modelSelection next selection, which also covers a picked-but-unsent model",
        "Cold history falls back to the provider of the last real request"
      ]
    },
    {
      "dot": "emerald",
      "title": "Brand rendering",
      "items": [
        "Provider route picks the main logo; the model id picks the corner logo",
        "Gateway routes can show three layers: gateway, transit platform, model vendor",
        "Unknown vendors get no corner logo; the 14×14 footprint never changes"
      ]
    },
    {
      "dot": "rose",
      "title": "Boundaries",
      "items": [
        "No configuration, no network requests, no files written",
        "Rows are matched by the official data-row-key, so duplicate titles never swap badges"
      ]
    }
  ]
