#!/usr/bin/env bash
# ohmydsh/dsh — start DSH from this customization repo (bash 命令,非阻塞).
#
#   dsh            非阻塞启动:未运行 → 后台拉起,就绪后按 web.open 决定是否打开 UI;
#                  已运行 → 打开规则同上;UI 也已打开 → 提示已在运行
#   dsh --open     强制自动打开 UI(覆盖 manifest web.open: false)
#   dsh --no-open  启动/检测时不自动打开 UI(优先级最高)
#   dsh --foreground 前台运行(调试用,阻塞)
#   dsh -b         重新 build(安装/同步 plugins)后再启动
#   dsh build      只 build,不启动
#   dsh stop       停止 dsh web 进程,并关闭 UI(PWA;浏览器标签请手动关)
#   dsh restart    重启:stop → 等端口释放 → start(避免 stop & dsh 竞态)
#   dsh reset      一键清零自定义 plugins(patch/preset/skill 一并重置;可 dsh build 恢复)
#   dsh history    查看历次启动清单(时间 / 版本 / 端口 / 加载的 plugins)
#   dsh plugin-update 统一升级远端插件(检测 → 确认 → 改 dsh.yaml → sync → 自动提交;
#                   --dry-run 只预览;--yes 跳过逐条确认)
#   dsh -p 8080    指定端口(默认 3080)
#   官方 CLI 命令自动转交,直接用即可:dsh plugin --profile web add <pkg>、
#                   dsh --profile <name>、dsh --dump-config(插件安装仍建议走 dsh.yaml + dsh build)
#
# autoUpdate(默认开启):start/-b/build/restart 前置检测 registry 最新 DSH 版本,
#   有更新且工作区干净时阻塞式自动升级(改 dsh.yaml + 同族 pin → 重跑 sync → 自动提交)再启动;
#   逃生门:autoUpdate.enabled:false 或 DSH_SKIP_UPDATE=1;频道:autoUpdate.channel / DSH_UPDATE_CHANNEL。
#
# 本地环境:仓库根 .env.local(gitignored)可放 DSH_OPEN_APP 等;也可行内临时传入,
# 如 DSH_OPEN_APP="xxx.app" dsh。DSH_OPEN_APP = PWA/App 路径或名称时打开该应用。
#
# 安装: 仓库根先 ./scripts/bootstrap.sh 初始化依赖,再 ./scripts/install.sh(默认装到 ~/.local/bin/dsh,幂等可重跑,可卸载)
set -euo pipefail

# Resolve symlinks so the repo path is correct when invoked via ~/.local/bin/dsh
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
REPO="$(cd "$(dirname "$SOURCE")/.." && pwd)"
# shellcheck disable=SC1091
source "$REPO/scripts/lib/dsh-runtime.sh"

# Local overrides (gitignored; optional)
if [[ -f "$REPO/.env.local" ]]; then
  set -a
  # shellcheck disable=SC1091
  source "$REPO/.env.local"
  set +a
fi

# Snapshot the user's explicit registry override before this launcher runs any
# npm operation of its own. bin/dsh is a bash script invoked straight from the
# user's shell, so a value visible at this point normally can only come from
# the user — inline env, an exported shell var, or .env.local (all deliberate).
# npm/npx bake npm_config_* only into processes they spawn, never into their
# caller. That is what lets start_server tell "user intent" apart from "npm
# exec baked it in" when it strips the inherited npm environment (design D1).
#
# The exception is the launcher itself being run by a package manager
# (`npm run dsh`, `npx ohmydsh`, …): then the entry environment is already
# baked and the value is NOT user intent. npm sets npm_command for exactly
# those invocations and never for a plain shell call, so it is a reliable
# witness. Per spec, a source we cannot attribute to the user must be treated
# as implicit and stripped — never passed off as intent.
if [[ -n "${npm_command:-}" ]]; then
  DSH_USER_REGISTRY=""
else
  DSH_USER_REGISTRY="${npm_config_registry:-${NPM_CONFIG_REGISTRY:-}}"
fi

DSH_HOME="${DSH_HOME:-$HOME/.dsh}"
PROFILE="${DSH_PROFILE:-web}"
PROFILE_PKG="$DSH_HOME/profiles/$PROFILE/package.json"
STARTUP_LOG="$DSH_HOME/dsh-startup.log"

# Repo default registry: the committed repo .npmrc is the source for this
# launcher's own npm work, so version detection (check-update.mjs → npmjs) and
# installs use the same source. The repo and its lockfiles must not depend on
# internal mirrors. Explicit npm_config_registry / NPM_CONFIG_REGISTRY /
# .env.local still take precedence.
#
# This value is NOT exported: an exported npm_config_registry propagates down
# the whole process tree (launcher → DSH server → agent shells) and, because
# env beats every .npmrc, would silently retarget unrelated npm/pnpm/rush work
# in other repositories. Injection is per-call via with_repo_registry instead
# (design D1). NB: npm 11 honors the lowercase npm_config_* env form only.
REPO_REGISTRY=""
if [[ -f "$REPO/.npmrc" ]]; then
  REPO_REGISTRY="$(sed -n 's/^[[:space:]]*registry[[:space:]]*=[[:space:]]*"\{0,1\}\([^"[:space:]]*\)"\{0,1\}[[:space:]]*/\1/p' "$REPO/.npmrc" | head -1)"
fi

# Run one command with the repo registry applied, scoped to that command only.
# A user-supplied override wins and is left untouched.
with_repo_registry() {
  if [[ -n "$REPO_REGISTRY" && -z "$DSH_USER_REGISTRY" ]]; then
    npm_config_registry="$REPO_REGISTRY" "$@"
  else
    "$@"
  fi
}

PORT=3080
BUILD=0
BUILD_ONLY=0
STOP=0
RESTART=0
NO_OPEN=0
OPEN=0
RESET=0
FOREGROUND=0
HISTORY=0
PLUGIN_UPDATE=0
DRY_RUN=""
YES_FLAG=""
PASSTHRU=()

usage() {
  sed -n '2,20p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
  exit 0
}

dsh_version() {
  grep -m1 '^dshVersion:' "$REPO/dsh.yaml" | sed -E 's/^dshVersion:[[:space:]]*"?([^"#[:space:]]+).*/\1/'
}

# ---------- 官方 CLI 直通 ----------
# `dsh` 这个名字同时是本启动器与官方 @deepseek-ai/dsh CLI 的入口,而用户 PATH
# 里通常只有 ~/.local/bin/dsh(本启动器)。官方 CLI 的调用形式若落到这里,旧实现
# 会把不认识的参数塞进 PASSTHRU 拼到 `dsh web` 之后 —— 但 web 子命令没有
# --profile,于是冷启动直接死在 `error: unknown option '--profile'`。
#
# 因此在解析自己的参数之前先判定:这次调用属于官方 CLI 吗?属于就原样转交,
# 让 `dsh plugin --profile web add <pkg>`、`dsh --dump-config` 等按官方语义工作。
# 判定只认官方独有的顶层选项与 plugin 子命令,不会截走启动器自己的命令
# (注意 plugin-update 是本仓库命令,与官方 plugin 精确区分)。
is_official_cli_invocation() {
  local first_positional="" a
  for a in "$@"; do
    case "$a" in
      # 官方顶层独有选项:启动器没有同名参数,出现即代表调用官方 CLI
      --profile|--profile=*|--patch|--patch=*|--dump-config|--dump-default-config) return 0 ;;
    esac
    if [[ -z "$first_positional" && "$a" != -* ]]; then first_positional="$a"; fi
  done
  # 官方子命令(精确匹配,避免误吞本仓库的 plugin-update)
  [[ "$first_positional" == "plugin" ]]
}

if is_official_cli_invocation "$@"; then
  CLI_VER="$(dsh_version)"
  if [[ -z "$CLI_VER" ]]; then
    echo "error: dshVersion missing in $REPO/dsh.yaml" >&2
    exit 1
  fi
  export DSH_CLI_VERSION="$CLI_VER"
  with_repo_registry exec node "$REPO/scripts/dsh-cli.mjs" "$@"
fi

while [[ $# -gt 0 ]]; do
  case "$1" in
    build) BUILD_ONLY=1; shift ;;
    # 官方 `dsh web` = 启动 web profile,语义与本启动器默认行为一致。吸收掉它,
    # 否则会被当作未知参数透传成 `dsh web --port N web`(多余位置参数 → 报错)。
    web) shift ;;
    stop) STOP=1; shift ;;
    restart) RESTART=1; shift ;;
    reset) RESET=1; shift ;;
    history) HISTORY=1; shift ;;
    plugin-update) PLUGIN_UPDATE=1; shift ;;
    --dry-run) DRY_RUN=1; shift ;;
    -y|--yes) YES_FLAG=1; shift ;;
    -b|--build) BUILD=1; shift ;;
    -d|--daemon) shift ;;        # 兼容保留:默认即非阻塞后台
    --foreground) FOREGROUND=1; shift ;;
    --open) OPEN=1; shift ;;
    --no-open) NO_OPEN=1; shift ;;
    -p|--port) PORT="$2"; shift 2 ;;
    --port=*) PORT="${1#*=}"; shift ;;
    -h|--help) usage ;;
    # 官方 web app 自己的参数:原样透传给 `dsh web`(--host 会覆盖 LAN 绑定)。
    --host|--trusted-host) PASSTHRU+=("$1" "$2"); shift 2 ;;
    --host=*|--trusted-host=*) PASSTHRU+=("$1"); shift ;;
    # 其余一律拒绝。旧实现静默透传,拼错的参数会被拼到 `dsh web` 之后,
    # 让服务冷启动直接失败(且错误只出现在 dsh.log 里,极难定位)。
    *)
      echo "error: 无法识别的参数 '$1'" >&2
      echo "       启动器参数见 dsh --help;官方 web 参数仅支持 --host/--port/--no-open/--trusted-host" >&2
      echo "       官方 CLI 命令(plugin/--profile/--dump-config)会自动转交,无需手动处理" >&2
      exit 1
      ;;
  esac
done

do_build() {
  with_repo_registry node "$REPO/scripts/sync.mjs"
}

# UI 对应的进程名:显式 DSH_OPEN_APP 优先,否则自动探测的 PWA;无 → 空。
ui_app_name() {
  local app="${DSH_OPEN_APP:-}"
  [[ -z "$app" ]] && app="$(pwa_app_of)"
  [[ -z "$app" ]] && return 1
  if [[ "$app" == *.app ]]; then basename "$app" .app; else echo "$app"; fi
}

# Chrome PWA 的进程 argv 是 --app-id 而非应用名,pgrep 认不出;macOS 上
# 先走 lsappinfo(按注册名取 pid),失败再回退 pgrep。
ui_pid() {
  local name
  name="$(ui_app_name 2>/dev/null)" || return 1
  if command -v lsappinfo >/dev/null 2>&1; then
    local out
    out="$(lsappinfo info -only pid "$name" 2>/dev/null | sed -n 's/^"pid"=//p')"
    [[ -n "$out" ]] && { echo "$out"; return 0; }
  fi
  pgrep -f "$name" 2>/dev/null | head -1
}

is_ui_open() { [[ -n "$(ui_pid)" ]]; }

# macOS Apple Events can wait forever when Chrome has a wedged window/process.
# Keep UI cleanup best-effort and bounded so stop/restart can always reach the
# server lifecycle. Kill only the osascript child we spawned, never Chrome.
run_osascript_bounded() {
  local timeout_s="${1:-3}" pid status=0
  shift
  osascript "$@" &
  pid=$!
  (
    sleep "$timeout_s"
    kill -TERM "$pid" 2>/dev/null || true
    sleep 0.2
    kill -KILL "$pid" 2>/dev/null || true
  ) &
  local watchdog=$!
  wait "$pid" || status=$?
  kill -TERM "$watchdog" 2>/dev/null || true
  wait "$watchdog" 2>/dev/null || true
  return "$status"
}

# 优雅退出 PWA;Chrome app-mode 进程的 argv 不含应用名,ui_pid 通过
# lsappinfo 定位。AppleScript 失败或超时才按已验证的 pid 发 TERM。
close_ui() {
  local pid name
  pid="$(ui_pid)" || return 0
  name="$(ui_app_name 2>/dev/null)" || true
  if [[ -n "$name" ]] && command -v osascript >/dev/null 2>&1; then
    run_osascript_bounded 3 -e "tell application \"$name\" to quit" >/dev/null 2>&1 && {
      for _ in $(seq 1 20); do [[ -z "$(ui_pid)" ]] && return 0; sleep 0.1; done
    }
  fi
  kill -TERM "$pid" 2>/dev/null || true
}

# 清理 Chrome 普通窗口里同端口的遗留 DSH 标签。Chrome 的 AppleScript
# windows 也包含 PWA app-mode 窗口,所以必须在 close_ui 之后调用。
close_browser_ui_tabs() {
  command -v osascript >/dev/null 2>&1 || return 0
  run_osascript_bounded 3 - "$PORT" >/dev/null 2>&1 <<'APPLESCRIPT' || true
on run argv
  set targetPrefix to "http://127.0.0.1:" & (item 1 of argv) & "/"
  tell application "Google Chrome"
    repeat with w in windows
      repeat with i from (count of tabs of w) to 1 by -1
        set t to tab i of w
        if (URL of t starts with targetPrefix) then close t
      end repeat
    end repeat
  end tell
end run
APPLESCRIPT
}

do_stop() {
  local server_rc=0 ui_was_open=0
  is_ui_open && ui_was_open=1

  if stop_dsh_server_on_port "$PORT"; then
    echo "dsh server stopped(port $PORT)"
  else
    server_rc=$?
    case "$server_rc" in
      1) echo "no dsh server found on port $PORT" ;;
      2) echo "error: port $PORT listener is not provably DSH;refusing to kill" >&2 ;;
      3) echo "error: lsof is required to stop DSH safely" >&2 ;;
      4) echo "error: DSH server on port $PORT did not stop" >&2 ;;
      *) echo "error: failed to stop DSH server on port $PORT(rc=$server_rc)" >&2 ;;
    esac
  fi

  # UI 生命周期独立于 server 匹配结果:旧实现这里提前 return,升级后 argv
  # 改变便跳过 UI 清理,是 restart 双开的直接原因。
  if [[ $ui_was_open -eq 1 ]]; then close_ui; fi
  close_browser_ui_tabs
  if [[ $ui_was_open -eq 1 ]]; then
    echo "dsh UI stopped(PWA/浏览器标签已关闭)"
  else
    echo "dsh UI stopped(浏览器标签已清理,PWA 未在运行)"
  fi

  [[ $server_rc -eq 0 || $server_rc -eq 1 ]]
}

# stop 已负责等待精确 listener pid 退出;restart 只需确认端口确实释放。
do_restart() {
  do_stop || return 1
  if nc -z 127.0.0.1 "$PORT" >/dev/null 2>&1; then
    echo "error: port $PORT still busy after stopping DSH" >&2
    return 1
  fi
  echo "port $PORT released"
}

do_history() {
  if [[ -f "$STARTUP_LOG" ]]; then
    tail -n 20 "$STARTUP_LOG"
  else
    echo "no startup history yet (run dsh to start one)"
  fi
}

# Print the plugin list this profile would load / loaded, one per line, with a note
print_plugins() {
  local out
  out="$(node "$REPO/scripts/plugin-list.mjs" 2>/dev/null || true)"
  if [[ -n "$out" ]]; then
    echo "加载的 plugins:"
    echo "$out" | sed 's/^/  - /'
  else
    echo "加载的 plugins:(无法读取 profile 清单)"
  fi
}

# Append one startup record: timestamp, dsh version, port, loaded plugins
record_startup() {
  local VER="$1" bundles=""
  if [[ -f "$PROFILE_PKG" ]]; then
    bundles="$(node -e 'const p=require(process.argv[1]);console.log((p.dsh&&p.dsh.profile&&p.dsh.profile.bundles||[]).join(", "))' "$PROFILE_PKG" 2>/dev/null || true)"
  fi
  printf '[%s] dshVersion=%s port=%s plugins=[%s]\n' "$(date '+%Y-%m-%dT%H:%M:%S%z')" "$VER" "$PORT" "$bundles" >>"$STARTUP_LOG"
}

is_server_up() {
  nc -z 127.0.0.1 "$PORT" >/dev/null 2>&1
}

is_ui_open() {
  local name
  name="$(ui_app_name 2>/dev/null)" || return 1
  pgrep -f "$name" >/dev/null 2>&1
}

wait_for_port() {
  local port="$1" tries="${2:-60}" pid="${3:-}"
  for _ in $(seq 1 "$tries"); do
    if [[ -n "$pid" ]] && ! kill -0 "$pid" 2>/dev/null; then
      return 2 # server process exited early
    fi
    if nc -z 127.0.0.1 "$port" >/dev/null 2>&1; then return 0; fi
    sleep 0.5
  done
  return 1
}

# 探测已安装的 DeepSeek Harness PWA(Chrome Apps 目录)。未显式配置
# DSH_OPEN_APP 时,若唯一匹配则只开 PWA;多个/无匹配 → 浏览器。
pwa_app_of() {
  local found=""
  shopt -s nullglob nocaseglob
  for p in "$HOME"/Applications/Chrome\ Apps.localized/*DeepSeek\ Harness.app "$HOME"/Applications/*DeepSeek\ Harness.app; do
    if [[ -d "$p" ]]; then
      if [[ -n "$found" ]]; then echo ""; return 0; fi
      found="$p"
    fi
  done
  shopt -u nullglob nocaseglob
  echo "$found"
}

# UI 自动打开开关(manifest web.open):缺省 true = 保持"就绪后打开"旧行为;
# 解析失败时同样按 true 处理(fail-open,不因配置损坏静默改变行为)。
ui_manifest_open_enabled() {
  local v
  v="$(node -e '
    const path = require("node:path")
    const fs = require("node:fs")
    const yaml = require(path.join(process.argv[1], "node_modules", "js-yaml"))
    const doc = yaml.load(fs.readFileSync(path.join(process.argv[1], "dsh.yaml"), "utf8"))
    console.log(doc && doc.web && doc.web.open === false ? "" : "1")
  ' "$REPO" 2>/dev/null)"
  [[ "$v" == "1" ]]
}

# 是否允许自动打开 UI:--no-open 显式禁止;--open 强制;否则遵循 manifest web.open。
ui_should_open() {
  [[ $NO_OPEN -eq 1 ]] && return 1
  [[ $OPEN -eq 1 ]] && return 0
  ui_manifest_open_enabled
}

# 记录 UI 打开决策(时间 + 目标),便于事后溯源"是谁开了什么"。
ui_log() { printf '[%s] UI %s\n' "$(date '+%Y-%m-%dT%H:%M:%S%z')" "$*" >> "$DSH_HOME/dsh-ui.log"; }

open_ui() {
  if ! ui_should_open; then
    ui_log "suppressed(--no-open / web.open=false)"
    return 1
  fi
  local url="http://127.0.0.1:$PORT"
  local app="${DSH_OPEN_APP:-}"
  if [[ -z "$app" ]]; then
    app="$(pwa_app_of)"
    if [[ -n "$app" ]] && [[ "$app" == *.app && -e "$app" ]]; then
      if open "$app"; then
        echo "UI: 已打开 PWA($app)"
        ui_log "open pwa $app"
        return 0
      fi
      echo "warn: 打开 PWA 失败,回退浏览器" >&2
      app=""
    fi
  fi
  if [[ -n "$app" ]]; then
    if [[ "$app" == *.app && -e "$app" ]]; then
      # installed PWA: launch the app (it opens its own start_url);失败才回退浏览器
      if open "$app"; then
        echo "UI: 已打开 PWA($app)"
        ui_log "open pwa $app"
        return 0
      fi
      echo "warn: 打开 PWA 失败($app),回退浏览器" >&2
    else
      # application name: open the URL with it
      if open -a "$app" "$url" 2>/dev/null; then
        echo "UI: 已通过 $app 打开"
        ui_log "open app $app $url"
        return 0
      fi
      echo "warn: 打开 $app 失败,回退浏览器" >&2
    fi
  fi
  if command -v open >/dev/null 2>&1; then
    open "$url"
    echo "UI: 已打开浏览器 $url"
    ui_log "open browser $url"
  elif command -v xdg-open >/dev/null 2>&1; then
    xdg-open "$url" >/dev/null 2>&1 || true
    echo "UI: 已打开浏览器 $url"
    ui_log "open browser(linux) $url"
  else
    echo "dsh started — open $url"
    ui_log "print url(no opener) $url"
  fi
}

# npm/npx bake their resolved config into a batch of npm_* variables for every
# process they spawn. The DSH server is long-lived and hands its environment to
# every agent shell, so anything inherited here silently retargets the user's
# npm/pnpm/rush work in unrelated repositories — env outranks every .npmrc.
# Resolving the CLI and running it under node (see start_server) means npm never
# spawns the server, so these are not generated in the first place; stripping
# them is defence in depth for the case where the launcher itself was started
# from `npm run` and inherited a polluted environment.
#
# A registry the user set explicitly is restored afterwards by start_server:
# that is intent, not inherited noise (design D1/D3).
server_env_strip_args() {
  local name
  while IFS= read -r name; do
    [[ -n "$name" ]] && printf '%s\0' "-u$name"
  done < <(compgen -e | grep -E '^npm_(config_|lifecycle_|package_)|^npm_(command|execpath|node_execpath)$' || true)
}

start_server() {
  local VER pid server_bin resolve_out
  local -a env_args=() strip=()
  # 官方 dsh-web-app 默认也会打开浏览器。始终给官方 CLI 传 --no-open，
  # 确保本启动器的 open_ui 是唯一 UI opener（否则一次 dsh 会打开两个 tab）。
  VER="$(dsh_version)"
  if [[ -z "$VER" ]]; then
    echo "error: dshVersion missing in $REPO/dsh.yaml" >&2
    exit 1
  fi
  mkdir -p "$DSH_HOME"

  # Resolve the CLI entry (DSH_BIN → npx cache → pnpm dir → install channels).
  # Resolution may install, so it runs with the repo registry applied; the
  # server itself is then launched with a clean environment.
  #
  # A cold start installs the CLI first, and those installers stream progress
  # onto this same stdout, so read the DSH_SERVER_BIN= marker line instead of
  # treating the whole capture as a path.
  if ! resolve_out="$(DSH_CLI_VERSION="$VER" with_repo_registry node "$REPO/scripts/dsh-server-bin.mjs")"; then
    echo "error: 无法解析 DSH CLI(@deepseek-ai/dsh@$VER)" >&2
    exit 1
  fi
  server_bin="$(printf '%s\n' "$resolve_out" | sed -n 's/^DSH_SERVER_BIN=//p' | tail -1)"
  if [[ -z "$server_bin" ]]; then
    echo "error: DSH CLI 解析未返回 bin 路径(@deepseek-ai/dsh@$VER)" >&2
    exit 1
  fi

  while IFS= read -r -d '' arg; do strip+=("$arg"); done < <(server_env_strip_args)
  env_args=(env "${strip[@]+"${strip[@]}"}")
  # Re-apply the user's own override on top of the cleaned environment.
  [[ -n "$DSH_USER_REGISTRY" ]] && env_args+=("npm_config_registry=$DSH_USER_REGISTRY")

  record_startup "$VER"
  if [[ $FOREGROUND -eq 1 ]]; then
    "${env_args[@]}" node "$server_bin" web --port "$PORT" --no-open ${PASSTHRU[@]+"${PASSTHRU[@]}"} &
    pid=$!
    trap 'kill -TERM "${pid:-}" 2>/dev/null || true' INT TERM
    if wait_for_port "$PORT" 60 "$pid"; then
      if open_ui; then
        echo "dsh 已启动: http://127.0.0.1:$PORT (dshVersion=$VER)"
      else
        echo "dsh 已启动: http://127.0.0.1:$PORT (dshVersion=$VER;未自动打开 UI,可 dsh --open)"
      fi
      print_plugins
    elif kill -0 "$pid" 2>/dev/null; then
      echo "warn: server did not answer on port $PORT within 30s" >&2
    else
      echo "error: server exited early — check output above" >&2
    fi
    wait "$pid" || echo "dsh stopped"
  else
    nohup "${env_args[@]}" node "$server_bin" web --port "$PORT" --no-open ${PASSTHRU[@]+"${PASSTHRU[@]}"} >>"$DSH_HOME/dsh.log" 2>&1 &
    pid=$!
    disown 2>/dev/null || true
    if wait_for_port "$PORT" 60 "$pid"; then
      if open_ui; then
        echo "dsh 已启动: http://127.0.0.1:$PORT (dshVersion=$VER)"
      else
        echo "dsh 已启动: http://127.0.0.1:$PORT (dshVersion=$VER;未自动打开 UI,可 dsh --open)"
      fi
      print_plugins
    elif kill -0 "$pid" 2>/dev/null; then
      echo "warn: server did not answer on port $PORT — see $DSH_HOME/dsh.log" >&2
    else
      echo "error: server exited early — see $DSH_HOME/dsh.log" >&2
    fi
  fi
}

if [[ $STOP -eq 1 ]]; then
  do_stop
  exit 0
fi
if [[ $HISTORY -eq 1 ]]; then
  do_history
  exit 0
fi
if [[ $RESET -eq 1 ]]; then
  with_repo_registry node "$REPO/scripts/sync.mjs" --reset
  exit 0
fi

# ---------- autoUpdate:启动/构建前自动检测并升级 DSH 版本(见文件头部注释) ----------
AUTOUP_UPDATED=0   # 本次调用是否已完成自动升级(避免 -b/build 重复物化)

# check-update.mjs 输出 JSON 解析进全局变量;解析失败回退 AU_STATUS=error(fail-open)
autoup_parse() {
  local out="$1" fields
  AUTOUP_ENABLED=0; AU_STATUS="error"; AU_CURRENT=""; AU_LATEST=""; AU_CHANNEL=""; AU_ERROR=""
  [[ "$out" != \{* ]] && { AU_ERROR="check-update 输出异常"; return 1; }
  fields="$(printf '%s' "$out" | node -e '
    let d="";process.stdin.on("data",c=>d+=c).on("end",()=>{
      const esc=(s)=>"\""+String(s??"").replace(/[\\"$`]/g,"\\$&")+"\"";
      const j=JSON.parse(d);
      console.log("AUTOUP_ENABLED="+(j.enabled?1:0));
      console.log("AU_STATUS="+esc(j.status));
      console.log("AU_CURRENT="+esc(j.current));
      console.log("AU_LATEST="+esc(j.latest));
      console.log("AU_CHANNEL="+esc(j.channel));
      console.log("AU_ERROR="+esc(j.error));
    })'
  )" && eval "$fields"
}

# 记录 autoUpdate 事件到启动日志(kind: upgrade|skip|offline)
record_autoup_event() {
  local kind="$1" msg
  case "$kind" in
    upgrade) msg="autoUpdate: $2 -> $3 (channel=$4)" ;;
    skip)    msg="autoUpdate: skip upgrade to $2 ($3)" ;;
    offline) msg="autoUpdate: offline ($3)" ;;
  esac
  printf '[%s] %s\n' "$(date '+%Y-%m-%dT%H:%M:%S%z')" "$msg" >>"$STARTUP_LOG"
}

# 升级链:改写 dsh.yaml(含同族 pin)→ 重跑 sync → 自动 commit。任何失败即报错退出、不启动。
do_autoupgrade() {
  local rewrite_out
  echo "检测到新版本 $AU_CURRENT -> $AU_LATEST (channel=$AU_CHANNEL),开始自动升级..."
  rewrite_out="$(with_repo_registry node "$REPO/scripts/check-update.mjs" --rewrite-to "$AU_LATEST" 2>&1 || true)"
  if [[ "$rewrite_out" != *"wrote "* ]]; then
    echo "error: 自动改写 dsh.yaml 失败:" >&2
    echo "$rewrite_out" >&2
    exit 1
  fi
  printf '%s\n' "$rewrite_out" | sed -n 's/^rewrite: /  /p'
  if ! with_repo_registry node "$REPO/scripts/sync.mjs"; then
    echo "error: 升级后 sync 失败,从 dsh.yaml.bak 回滚 dsh.yaml" >&2
    cp "$REPO/dsh.yaml.bak" "$REPO/dsh.yaml"
    rm -f "$REPO/dsh.yaml.bak"
    exit 1
  fi
  if ! git -C "$REPO" add dsh.yaml || ! git -C "$REPO" commit --no-verify -m "chore(dsh): auto-bump $AU_CURRENT → $AU_LATEST" >/dev/null; then
    echo "error: 自动 commit 失败(dsh.yaml 已升级并完成 build)。处置:git commit dsh.yaml 保留,或 git checkout -- dsh.yaml 回滚" >&2
    exit 1
  fi
  rm -f "$REPO/dsh.yaml.bak"
  AUTOUP_UPDATED=1
  record_autoup_event upgrade "$AU_CURRENT" "$AU_LATEST" "$AU_CHANNEL"
  echo "DSH 已自动升级至 $AU_LATEST 并提交。"
}

# 检测 + 分支;始终返回 0(继续),升级链内部失败会直接 exit。
autoupdate() {
  local out
  out="$(with_repo_registry node "$REPO/scripts/check-update.mjs" 2>/dev/null || true)"
  if ! autoup_parse "$out"; then
    # 脚本本身不可用(空输出/非 JSON):fail-open,但显式警告,不静默吞掉
    echo "warn: 版本检测不可用($AU_ERROR),按当前版本继续"
    return 0
  fi
  if [[ $AUTOUP_ENABLED -ne 1 ]]; then return 0; fi
  case "$AU_STATUS" in
    update)
      if [[ -n "$(git -C "$REPO" status --porcelain)" ]]; then
        echo "检测到新版本 $AU_LATEST,但仓库有未提交改动,已跳过自动更新(提交后下次启动自动升级)"
        record_autoup_event skip "$AU_LATEST" "dirty-worktree"
        return 0
      fi
      do_autoupgrade
      ;;
    offline)
      echo "warn: 版本检测失败($AU_ERROR),按当前版本继续"
      record_autoup_event offline "" "$AU_ERROR"
      ;;
    no-update) : ;;
    *)
      echo "warn: 版本检测不可用($AU_ERROR),按当前版本继续"
      ;;
  esac
  return 0
}

if [[ $PLUGIN_UPDATE -eq 1 ]]; then
  with_repo_registry node "$REPO/scripts/plugin-update.mjs" ${DRY_RUN:+--dry-run} ${YES_FLAG:+--yes}
  exit $?
fi

if [[ $BUILD_ONLY -eq 1 || $BUILD -eq 1 || $RESTART -eq 1 ]] || ! is_server_up; then
  autoupdate
fi

if [[ $BUILD_ONLY -eq 1 ]]; then
  [[ $AUTOUP_UPDATED -ne 1 ]] && do_build
  exit 0
fi
if [[ $BUILD -eq 1 ]]; then
  [[ $AUTOUP_UPDATED -ne 1 ]] && do_build
fi

if [[ $RESTART -eq 1 ]]; then
  do_restart
fi

# Idempotent start: reuse the running instance instead of spawning another
if is_server_up; then
  if [[ $NO_OPEN -eq 1 ]]; then
    echo "dsh 已在运行: http://127.0.0.1:$PORT"
    print_plugins
    exit 0
  fi
  if is_ui_open; then
    echo "dsh 已在运行(UI 已打开): http://127.0.0.1:$PORT"
    print_plugins
    exit 0
  fi
  if open_ui; then
    echo "dsh 已在运行,已为你打开 UI: http://127.0.0.1:$PORT"
  else
    echo "dsh 已在运行: http://127.0.0.1:$PORT (未自动打开 UI,可 dsh --open)"
  fi
  print_plugins
  exit 0
fi

start_server
