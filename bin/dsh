#!/usr/bin/env bash
# zydsh/dsh — start DSH from this customization repo (bash & fish 通用命令).
#
#   dsh            用上次 build 启动;服务就绪后自动打开 web UI(默认)
#   dsh --no-open  启动但不打开浏览器
#   dsh -b         重新 build(安装/同步 plugins)后再启动
#   dsh build      只 build,不启动
#   dsh -d         后台启动并打开浏览器
#   dsh stop       停止 dsh web 进程
#   dsh -p 8080    指定端口(默认 3080)
#
# 本地环境:仓库根 .env.local(gitignored)可放 DSH_OPEN_APP 等;也可行内临时传入,
# 如 DSH_OPEN_APP="xxx.app" dsh。DSH_OPEN_APP = PWA/App 路径或名称时打开该应用。
#
# 安装: ln -s <repo>/bin/dsh ~/.local/bin/dsh(两 shell 的 PATH 均含 ~/.local/bin)
set -euo pipefail

# Resolve symlinks so the repo path is correct when invoked via ~/.local/bin/dsh
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
REPO="$(cd "$(dirname "$SOURCE")/.." && pwd)"

# Local overrides (gitignored; optional)
if [[ -f "$REPO/.env.local" ]]; then
  set -a
  # shellcheck disable=SC1091
  source "$REPO/.env.local"
  set +a
fi

DSH_HOME="${DSH_HOME:-$HOME/.dsh}"
PORT=3080
BUILD=0
BUILD_ONLY=0
DAEMON=0
STOP=0
NO_OPEN=0
PASSTHRU=()

usage() {
  sed -n '2,11p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
  exit 0
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    build) BUILD_ONLY=1; shift ;;
    stop) STOP=1; shift ;;
    -b|--build) BUILD=1; shift ;;
    -d|--daemon) DAEMON=1; shift ;;
    --no-open) NO_OPEN=1; shift ;;
    -p|--port) PORT="$2"; shift 2 ;;
    --port=*) PORT="${1#*=}"; shift ;;
    -h|--help) usage ;;
    *) PASSTHRU+=("$1"); shift ;;
  esac
done

dsh_version() {
  grep -m1 '^dshVersion:' "$REPO/dsh.yaml" | sed -E 's/^dshVersion:[[:space:]]*"?([^"#[:space:]]+).*/\1/'
}

do_build() {
  node "$REPO/scripts/sync.mjs"
}

do_stop() {
  if pkill -f '\.bin/dsh web'; then
    echo "dsh stopped"
  else
    echo "no dsh process found"
  fi
}

wait_for_port() {
  local port="$1" tries="${2:-60}"
  for _ in $(seq 1 "$tries"); do
    if nc -z 127.0.0.1 "$port" >/dev/null 2>&1; then return 0; fi
    sleep 0.5
  done
  return 1
}

open_ui() {
  [[ $NO_OPEN -eq 1 ]] && return 0
  local url="http://127.0.0.1:$PORT"
  if [[ -n "${DSH_OPEN_APP:-}" ]]; then
    if [[ "$DSH_OPEN_APP" == *.app && -e "$DSH_OPEN_APP" ]]; then
      # installed PWA: launch the app (it opens its own start_url)
      open "$DSH_OPEN_APP"
    else
      # application name: open the URL with it
      open -a "$DSH_OPEN_APP" "$url" 2>/dev/null || open "$url"
    fi
    return 0
  fi
  if command -v open >/dev/null 2>&1; then
    open "$url"
  elif command -v xdg-open >/dev/null 2>&1; then
    xdg-open "$url" >/dev/null 2>&1 || true
  else
    echo "dsh started — open $url"
  fi
}

do_start() {
  local VER
  VER="$(dsh_version)"
  if [[ -z "$VER" ]]; then
    echo "error: dshVersion missing in $REPO/dsh.yaml" >&2
    exit 1
  fi
  if [[ $DAEMON -eq 1 ]]; then
    mkdir -p "$DSH_HOME"
    nohup npx -y "@deepseek-ai/dsh@$VER" web --port "$PORT" "${PASSTHRU[@]}" >>"$DSH_HOME/dsh.log" 2>&1 &
    disown 2>/dev/null || true
    if wait_for_port "$PORT"; then
      open_ui
    else
      echo "warn: server did not answer on port $PORT — see $DSH_HOME/dsh.log" >&2
    fi
  else
    npx -y "@deepseek-ai/dsh@$VER" web --port "$PORT" "${PASSTHRU[@]}" &
    local pid=$!
    trap 'kill -TERM "${pid:-}" 2>/dev/null || true' INT TERM
    if wait_for_port "$PORT"; then
      open_ui
    else
      echo "warn: server did not answer on port $PORT within 30s" >&2
    fi
    wait "$pid"
  fi
}

if [[ $STOP -eq 1 ]]; then
  do_stop
  exit 0
fi
if [[ $BUILD_ONLY -eq 1 ]]; then
  do_build
  exit 0
fi
if [[ $BUILD -eq 1 ]]; then
  do_build
fi
do_start
