#!/usr/bin/env bash
# Legacy POSIX link compatibility only; npm bin uses dsh.mjs directly.
set -euo pipefail
if ! command -v node >/dev/null 2>&1; then
  printf '%s\n' 'error: Node.js >=22.0.0 is required: https://nodejs.org/' >&2
  exit 1
fi
SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
  DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
exec node "$(dirname "$SOURCE")/dsh.mjs" "$@"
