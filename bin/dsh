#!/usr/bin/env bash
# zydsh/dsh — start DSH from this customization repo (bash & fish 通用命令).
#
#   dsh            用上次 build 启动(默认;仓库更新不影响,除非显式 build)
#   dsh -b         重新 build(安装/同步 plugins)后再启动
#   dsh build      只 build,不启动
#   dsh -d         后台启动并打开浏览器
#   dsh stop       停止 dsh web 进程
#   dsh -p 8080    指定端口(默认 3080)
#
# 安装: ln -s <repo>/bin/dsh ~/.local/bin/dsh(两 shell 的 PATH 均含 ~/.local/bin)
set -euo pipefail

# Resolve symlinks so the repo path is correct when invoked via ~/.local/bin/dsh
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
REPO="$(cd "$(dirname "$SOURCE")/.." && pwd)"
DSH_HOME="${DSH_HOME:-$HOME/.dsh}"
PORT=3080
BUILD=0
BUILD_ONLY=0
DAEMON=0
STOP=0
PASSTHRU=()

usage() {
  sed -n '2,11p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
  exit 0
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    build) BUILD_ONLY=1; shift ;;
    stop) STOP=1; shift ;;
    -b|--build) BUILD=1; shift ;;
    -d|--daemon) DAEMON=1; shift ;;
    -p|--port) PORT="$2"; shift 2 ;;
    --port=*) PORT="${1#*=}"; shift ;;
    -h|--help) usage ;;
    *) PASSTHRU+=("$1"); shift ;;
  esac
done

dsh_version() {
  grep -m1 '^dshVersion:' "$REPO/dsh.yaml" | sed -E 's/^dshVersion:[[:space:]]*"?([^"#[:space:]]+).*/\1/'
}

do_build() {
  node "$REPO/scripts/sync.mjs"
}

do_stop() {
  if pkill -f '\.bin/dsh web'; then
    echo "dsh stopped"
  else
    echo "no dsh process found"
  fi
}

do_start() {
  local VER
  VER="$(dsh_version)"
  if [[ -z "$VER" ]]; then
    echo "error: dshVersion missing in $REPO/dsh.yaml" >&2
    exit 1
  fi
  if [[ $DAEMON -eq 1 ]]; then
    mkdir -p "$DSH_HOME"
    nohup npx -y "@deepseek-ai/dsh@$VER" web --port "$PORT" "${PASSTHRU[@]}" >>"$DSH_HOME/dsh.log" 2>&1 &
    disown 2>/dev/null || true
    if command -v open >/dev/null 2>&1; then
      open "http://127.0.0.1:$PORT"
    else
      echo "dsh started — open http://127.0.0.1:$PORT"
    fi
  else
    exec npx -y "@deepseek-ai/dsh@$VER" web --port "$PORT" "${PASSTHRU[@]}"
  fi
}

if [[ $STOP -eq 1 ]]; then
  do_stop
  exit 0
fi
if [[ $BUILD_ONLY -eq 1 ]]; then
  do_build
  exit 0
fi
if [[ $BUILD -eq 1 ]]; then
  do_build
fi
do_start
