  "cards": [
    {
      "dot": "emerald",
      "title": "Run path",
      "items": [
        "bin/dsh is idempotent: not running → launch via npx and open UI; running → just open UI",
        "Single version source: dshVersion in dsh.yaml, read at launch",
        "Every launch prints the plugin list with notes (manifest note > package description)"
      ]
    },
    {
      "dot": "cyan",
      "title": "Materialization",
      "items": [
        "Local package → dsh plugin add file:<path>, lands in profile bundles",
        "Preset/skill → copied to ~/.dsh/.agent-presets and ~/.dsh/skills",
        "Third-party resources: exact version pin + integrity verified before materializing",
        "Private overlay (DSH_LOCAL_MANIFEST) can only append entries; it never overrides public ones"
      ]
    },
    {
      "dot": "violet",
      "title": "Truth-source rules",
      "items": [
        "The repository is the only truth source; hand edits in ~/.dsh are not kept",
        "Disable ≠ delete: enabled: false only stops materialization",
        "dsh reset clears all customizations; dsh build restores them"
      ]
    }
  ]
