  "cards": [
    {
      "dot": "emerald",
      "title": "运行链路",
      "items": [
        "bin/dsh 幂等启动:未运行 → npx 拉起 + 开 UI;已运行 → 直接开 UI",
        "版本单一来源:dsh.yaml 的 dshVersion,启动脚本运行时读取",
        "每次启动打印带备注的插件清单(manifest note > 包 description)"
      ]
    },
    {
      "dot": "cyan",
      "title": "物化规则",
      "items": [
        "package local → dsh plugin add file:<path>,自动进 profile bundles",
        "preset/skill → 复制到 ~/.dsh/.agent-presets、~/.dsh/skills",
        "patch → 按 manifest 顺序合并生成 cordis.patch.yml(带 generated 头)"
      ]
    },
    {
      "dot": "violet",
      "title": "真相源约定",
      "items": [
        "仓库是唯一真相源;~/.dsh 手改不保留",
        "禁用 ≠ 删除:enabled: false 只停止物化",
        "reset 一键清零自定义,dsh build 可恢复"
      ]
    }
  ]
