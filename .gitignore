node_modules/
.DS_Store
*.log
.env.local

# Local TypeScript package build output (generated by root build/sync).
packages/*/lib/
packages/dsh-federation/.generated/

# The root lockfile is the only dependency lock source.
packages/*/package-lock.json

# Acceptance raw evidence is ephemeral or externally retained; keep reports,
# trails, gates, scripts, and explicitly reviewed test fixtures in Git.
openspec/changes/**/checking/baselines/
openspec/changes/**/checking/screenshots/

# Host-capability spikes are throwaway probes. Their CONCLUSIONS live in the
# owning change's design doc; the scripts and raw output are not artifacts the
# repository needs to carry.
spike/

# Architecture source + one theme-aware SVG are tracked; duplicate exports are not.
# Everything else under archify-out/ is regenerable diagram output (per-diagram
# source JSON, rendered HTML/PNG, visual-check reports) plus talk material that
# belongs with its own change, so it stays out of version control. The two
# tracked files are re-allowed explicitly below and are also enforced by
# scripts/check-tracked-artifacts.mjs.
archify-out/*
!archify-out/ohmydsh-architecture.json
!archify-out/ohmydsh-architecture.dual.svg
worktree-session-architecture.html
