#!/usr/bin/env python3
"""Local-only adapter example: supply synthetic JSON via CASE_VERIFY_SAMPLE_JSON."""
import argparse
import json
import os
from pathlib import Path


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--describe', action='store_true')
    parser.add_argument('operation', nargs='?', choices=['fetch'])
    parser.add_argument('url', nargs='?')
    parser.add_argument('--out')
    args = parser.parse_args()
    if args.describe:
        print(json.dumps(dict(name='sample-qa', kind='oracle-source',
                              match=r'^https://qa\.example/case/', provenance='independent')))
        return
    if not args.operation or not args.url or not args.out:
        parser.error('fetch requires URL and --out DIR')
    source = os.environ.get('CASE_VERIFY_SAMPLE_JSON')
    if not source:
        parser.error('set CASE_VERIFY_SAMPLE_JSON to a synthetic local fragment')
    fragment = json.loads(Path(source).read_text(encoding='utf-8'))
    (Path(args.out) / 'oracle.fragment.json').write_text(
        json.dumps(fragment, ensure_ascii=False) + '\n', encoding='utf-8')


if __name__ == '__main__':
    main()
